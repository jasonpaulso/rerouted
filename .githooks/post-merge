#!/bin/sh
# Warn when a merge changed licensing terms.
#
# Upstream is MIT today. The grant on code already merged is irrevocable, but
# future upstream commits could ship under different terms. This fires at the
# moment that matters: when their code lands in our tree.
#
# Git has no fetch hook, so this cannot warn at download time. It also does not
# run on a conflicted merge or on rebase.

WATCHED="LICENSE LICENSE.* COPYING COPYING.* NOTICE package.json"

# $1 is 1 for a squash merge, which stages its changes and leaves HEAD alone.
# Diffing ORIG_HEAD..HEAD there compares a commit to itself and sees nothing,
# so compare the index instead. Upstream prefers squash merges, so this is the
# common path, not an edge case.
if [ "$1" = "1" ]; then
  before=HEAD
  after=""
  changed=$(git diff --cached --name-only HEAD -- $WATCHED)
else
  if ! git rev-parse --verify --quiet ORIG_HEAD >/dev/null; then
    exit 0
  fi
  before=ORIG_HEAD
  after=HEAD
  changed=$(git diff --name-only ORIG_HEAD HEAD -- $WATCHED)
fi

if [ -z "$changed" ]; then
  exit 0
fi

license_field() {
  git show "$1:package.json" 2>/dev/null |
    sed -n 's/.*"license"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

flagged=""
for file in $changed; do
  if [ "$file" = "package.json" ]; then
    # package.json churns constantly; only its license field is interesting.
    was=$(license_field "$before")
    now=$(license_field "$after")
    if [ "$was" != "$now" ]; then
      flagged="$flagged package.json(license: ${was:-none} -> ${now:-none})"
    fi
  else
    flagged="$flagged $file"
  fi
done

if [ -z "$flagged" ]; then
  exit 0
fi

if [ "$1" = "1" ]; then
  review="git diff --cached HEAD -- LICENSE package.json"
else
  review="git diff ORIG_HEAD HEAD -- LICENSE package.json"
fi

printf '\n\033[33m!\033[0m licensing terms changed in this merge:\033[1m%s\033[0m\n' "$flagged"
printf '  review before building on it:\n'
printf '    %s\n\n' "$review"
